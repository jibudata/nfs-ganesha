# Makefile for FSAL_SEAWEED Lean 4 Formal Verification (docs/formal)
# Ensures ~/.elan/bin is on PATH for non-interactive shells and CI.

SHELL := /usr/bin/env bash
export PATH := $(HOME)/.elan/bin:$(PATH)

BUNDLE_OUT ?= /tmp/FSALSeaweedFormal_review.lean
LEAN_MODULES := \
	FSALSeaweedFormal/Arena.lean \
	FSALSeaweedFormal/DirtyPageMap.lean \
	FSALSeaweedFormal/AsyncLifecycle.lean \
	FSALSeaweedFormal/DurabilityEpoch.lean \
	FSALSeaweedFormal/ChunkOrdering.lean \
	FSALSeaweedFormal/ObjectIdentity.lean \
	FSALSeaweedFormal/FilerCAS.lean \
	FSALSeaweedFormal.lean

.DEFAULT_GOAL := verify

.PHONY: help verify build audit bundle merge clean toolchain

help:
	@echo "Available targets:"
	@echo "  make verify     - Run full validation via ./verify.sh (default)"
	@echo "  make build      - Incremental lake build"
	@echo "  make audit      - Run #print axioms check on FSALSeaweedFormal.lean"
	@echo "  make bundle     - Merge all Lean files into a standalone temp file (OUT=$(BUNDLE_OUT))"
	@echo "  make merge      - Alias for bundle"
	@echo "  make clean      - Clean lake build artifacts and temp bundle"
	@echo "  make toolchain  - Show active lean/lake versions"

toolchain:
	@lean --version
	@lake --version

build:
	@lake build

audit: build
	@lake env lean FSALSeaweedFormal.lean

bundle:
	@out="$(if $(OUT),$(OUT),$(BUNDLE_OUT))"; \
	python3 -c 'import pathlib, re, sys; out_path = pathlib.Path(sys.argv[1]); out_path.parent.mkdir(parents=True, exist_ok=True); import_re = re.compile(r"^\s*import\s+FSALSeaweedFormal(\.[A-Za-z0-9_]+)?\s*$$"); sep = chr(61) * 76; chunks = ["/-!\n  FSAL_SEAWEED Standalone Review Bundle\n  Auto-generated by make bundle (internal imports stripped for single-file compilation).\n-/\n"]; [chunks.extend([f"\n-- {sep}\n-- FILE: {f}\n-- {sep}\n", "\n".join(ln for ln in pathlib.Path(f).read_text(encoding="utf-8").splitlines() if not import_re.match(ln)).strip() + "\n"]) for f in sys.argv[2:]]; out_path.write_text("\n".join(chunks), encoding="utf-8"); print(f"Generated standalone review bundle: {out_path} ({out_path.stat().st_size} bytes)")' "$$out" $(LEAN_MODULES) && \
	lean "$$out" >/dev/null && \
	echo "Standalone lean check PASSED: $$out"

merge: bundle

clean:
	@lake clean
	@rm -f "$(BUNDLE_OUT)"

verify:
	@./verify.sh
