# SeaweedFS common configuration - NFS-Ganesha FUSE backend (perf lab)
# Host: ys1000@192.168.3.146 (Ubuntu 24.04, 16 vCPU, 62 GiB RAM, NVMe SSD)

export SW_ROOT=/home/ys1000/seaweedfs
export SW_BIN=/usr/local/bin/weed
export SW_LOGS=$SW_ROOT/logs

# --- network / ports -------------------------------------------------------
# All services bind to loopback only: the FUSE mount is consumed locally by
# NFS-Ganesha, so keeping the SeaweedFS control/data plane on 127.0.0.1
# removes loopback-vs-NIC noise from the measurement.
export SW_IP=127.0.0.1

export SW_MASTER_HTTP=9333       # master http  (UI / REST)
export SW_MASTER_GRPC=19333      # master grpc  (volume+filer talk to this)
export SW_VOLUME_HTTP=8081       # volume http (8080 is taken by kubectl on this host)
export SW_VOLUME_GRPC=18081      # volume grpc
export SW_FILER_HTTP=8888        # filer http   (what `weed mount` dials)
export SW_FILER_GRPC=18888       # filer grpc

# --- storage layout (all on the NVMe SSD, ext4) ----------------------------
export SW_MASTER_DIR=$SW_ROOT/master     # raft / topology metadata
export SW_DATA_DIR=$SW_ROOT/data         # volume server .dat/.idx files
export SW_CACHE_DIR=$SW_ROOT/cache       # weed mount chunk staging cache
export SW_MNT=$SW_ROOT/mnt               # <-- FUSE mount point Ganesha exports

# --- weed mount tunables ---------------------------------------------------
export SW_CHUNK_SIZE_MB=2        # filer chunk size / local write buffer
export SW_WRITE_BUFFER_MB=4096   # global cap on per-mount write buffer
export SW_MAX_BACKGROUND=128     # FUSE max_background (in-flight async reqs)
export SW_CONGESTION_THRESHOLD=0 # 0 => kernel derives 3/4 of max_background
export SW_CACHE_CAPACITY_MB=128  # file chunk read cache capacity
export SW_CACHE_META_TTL=60      # metadata cache validity (seconds)
export SW_META_FLUSH_SEC=120     # periodic metadata flush to filer
export SW_CONC_WRITERS=128
export SW_CONC_READERS=128
